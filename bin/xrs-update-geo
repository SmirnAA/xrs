#!/usr/bin/env bash
set -euo pipefail

GEO_DIR="/usr/local/share/xray"
BASE_URL="https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download"
BACKUP_DIR="$GEO_DIR/backup"
CONFIG="/usr/local/etc/xray/config.json"
TMP_DIR=$(mktemp -d)

R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; N=$'\e[0m'

cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

# Устойчивая загрузка: GitHub-релизы тут часто троттлятся, и обычный curl
# висит на середине. Обрываем при стагнации (< 30КБ/с в течение 15с), повторяем
# с докачкой, и при неудаче пробуем через локальный прокси xray (socks 10808).
geo_fetch() {
  local url="$1" out="$2"
  local common=(-fL -C - --connect-timeout 10 --speed-limit 30000 --speed-time 15
                --retry 5 --retry-delay 2 --retry-all-errors)
  rm -f "$out"
  curl "${common[@]}" -o "$out" "$url" && return 0
  if ss -tlnH "sport = :10808" 2>/dev/null | grep -q LISTEN; then
    echo "  прямая загрузка не идёт — пробую через прокси (127.0.0.1:10808)"
    rm -f "$out"
    curl "${common[@]}" -x socks5h://127.0.0.1:10808 -o "$out" "$url" && return 0
  fi
  return 1
}

restore_backup() {
  if [ -f "$BACKUP_DIR/geoip.dat" ] && [ -f "$BACKUP_DIR/geosite.dat" ]; then
    sudo cp "$BACKUP_DIR/geoip.dat" "$BACKUP_DIR/geosite.dat" "$GEO_DIR/"
    echo "  ${G}✓ откат из бэкапа выполнен${N}"
  else
    echo "  ${Y}! бэкапа нет — откат невозможен${N}"
  fi
}

echo "${Y}[1/4]${N} Скачиваю новые geo-файлы..."
geo_fetch "$BASE_URL/geoip.dat"   "$TMP_DIR/geoip.dat"   || { echo "${R}✗ ошибка загрузки geoip.dat${N}";   exit 1; }
geo_fetch "$BASE_URL/geosite.dat" "$TMP_DIR/geosite.dat" || { echo "${R}✗ ошибка загрузки geosite.dat${N}"; exit 1; }

# Проверяем что файлы не пустые и похожи на protobuf
for f in geoip.dat geosite.dat; do
  size=$(stat -c%s "$TMP_DIR/$f")
  if [ "$size" -lt 100000 ]; then
    echo "${R}✗ $f слишком маленький (${size}B) — похоже на битую загрузку${N}"
    exit 1
  fi
done
echo "  geoip.dat:   $(du -h "$TMP_DIR/geoip.dat"   | cut -f1)"
echo "  geosite.dat: $(du -h "$TMP_DIR/geosite.dat" | cut -f1)"

echo "${Y}[2/4]${N} Сохраняю бэкап текущих файлов..."
if [ -f "$GEO_DIR/geoip.dat" ] && [ -f "$GEO_DIR/geosite.dat" ]; then
  sudo mkdir -p "$BACKUP_DIR"
  sudo cp "$GEO_DIR/geoip.dat" "$GEO_DIR/geosite.dat" "$BACKUP_DIR/"
  echo "  ${G}✓ бэкап в $BACKUP_DIR${N}"
else
  echo "  текущих файлов нет — первый запуск, бэкап пропущен"
fi

echo "${Y}[3/4]${N} Устанавливаю и проверяю совместимость с конфигом..."
sudo mkdir -p "$GEO_DIR"
sudo cp "$TMP_DIR/geoip.dat" "$TMP_DIR/geosite.dat" "$GEO_DIR/"

if [ ! -e "$CONFIG" ]; then
  echo "  ${Y}! активного конфига нет — проверка и перезапуск не нужны${N}"
  echo "${G}✓ geo-файлы обновлены${N}"
  exit 0
fi

if xray run -test -c "$CONFIG" 2>&1; then
  echo "  ${G}✓ конфиг валиден с новыми файлами${N}"
else
  echo "  ${R}✗ конфиг не проходит валидацию — откат${N}"
  restore_backup
  exit 1
fi

echo "${Y}[4/4]${N} Перезапускаю xray..."
if sudo systemctl restart xray && sleep 1 && systemctl is-active --quiet xray; then
  echo "${G}✓ готово — xray работает с новыми geo-файлами${N}"
else
  echo "${R}✗ xray не запустился — откат${N}"
  restore_backup
  sudo systemctl restart xray || true
  exit 1
fi
