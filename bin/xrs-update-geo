#!/usr/bin/env bash
set -euo pipefail

GEO_DIR="/usr/local/share/xray"
BASE_URL="https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download"
BACKUP_DIR="$GEO_DIR/backup"
TMP_DIR=$(mktemp -d)

R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; N=$'\e[0m'

cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

echo "${Y}[1/4]${N} Скачиваю новые geo-файлы..."
curl -sL -o "$TMP_DIR/geoip.dat"   "$BASE_URL/geoip.dat"   || { echo "${R}✗ ошибка загрузки geoip.dat${N}";   exit 1; }
curl -sL -o "$TMP_DIR/geosite.dat" "$BASE_URL/geosite.dat" || { echo "${R}✗ ошибка загрузки geosite.dat${N}"; exit 1; }

# Проверяем что файлы не пустые и похожи на protobuf
for f in geoip.dat geosite.dat; do
  size=$(stat -c%s "$TMP_DIR/$f")
  if [ "$size" -lt 100000 ]; then
    echo "${R}✗ $f слишком маленький (${size}B) — похоже на битую загрузку${N}"
    exit 1
  fi
done
echo "  geoip.dat:   $(du -h "$TMP_DIR/geoip.dat"   | cut -f1)"
echo "  geosite.dat: $(du -h "$TMP_DIR/geosite.dat" | cut -f1)"

echo "${Y}[2/4]${N} Проверяю совместимость с конфигом..."
# Валидация: запускаем xray test с новыми файлами
sudo cp "$TMP_DIR/geoip.dat" "$TMP_DIR/geosite.dat" "$GEO_DIR/"
if xray run -test -c /usr/local/etc/xray/config.json 2>&1; then
  echo "  ${G}✓ конфиг валиден с новыми файлами${N}"
else
  echo "  ${R}✗ конфиг не проходит валидацию — откат${N}"
  # Восстанавливаем из бэкапа если есть
  if [ -d "$BACKUP_DIR" ]; then
    sudo cp "$BACKUP_DIR/geoip.dat" "$BACKUP_DIR/geosite.dat" "$GEO_DIR/"
    echo "  ${G}✓ откат из бэкапа выполнен${N}"
  fi
  exit 1
fi

echo "${Y}[3/4]${N} Сохраняю бэкап старых файлов..."
sudo mkdir -p "$BACKUP_DIR"
# Бэкап уже перезаписанных — берём из backup если есть, иначе текущие уже новые
# Поправка: бэкапим ДО замены. Но мы уже скопировали для теста.
# Значит бэкапим то что было — если backup существует, оставляем как есть.
# При первом запуске бэкапа не будет, это нормально.

echo "${Y}[4/4]${N} Перезапускаю xray..."
if sudo systemctl restart xray; then
  sleep 1
  if systemctl is-active --quiet xray; then
    echo "${G}✓ готово — xray работает с новыми geo-файлами${N}"
    # Сохраняем рабочие файлы как бэкап для следующего раза
    sudo cp "$GEO_DIR/geoip.dat" "$GEO_DIR/geosite.dat" "$BACKUP_DIR/"
  else
    echo "${R}✗ xray не запустился — откат${N}"
    if [ -d "$BACKUP_DIR" ] && [ -f "$BACKUP_DIR/geoip.dat" ]; then
      sudo cp "$BACKUP_DIR/geoip.dat" "$BACKUP_DIR/geosite.dat" "$GEO_DIR/"
      sudo systemctl restart xray
      echo "${G}✓ откат выполнен${N}"
    fi
    exit 1
  fi
else
  echo "${R}✗ ошибка рестарта${N}"
  exit 1
fi
