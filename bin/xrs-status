#!/usr/bin/env bash
# xrs-status — full diagnostics of the xray setup

PROFILES_DIR="/etc/xray/profiles"
CONFIG_LINK="/usr/local/etc/xray/config.json"
SOCKS_PORT=10808
HTTP_PORT=10809

R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[34m'; D=$'\e[2m'; N=$'\e[0m'
ok()   { echo "  ${G}✓${N} $*"; }
bad()  { echo "  ${R}✗${N} $*"; }
warn() { echo "  ${Y}!${N} $*"; }
info() { echo "  ${D}·${N} $*"; }
hdr()  { echo; echo "${B}── $* ──${N}"; }

# ── 1. Active profile ──────────────────────────────────────────────
hdr "profile"
if [ -L "$CONFIG_LINK" ]; then
  current=$(basename "$(readlink -f "$CONFIG_LINK")" .json)
  ok "active: ${B}$current${N}"
  target=$(readlink -f "$CONFIG_LINK")
  info "file: $target"

  # extract the upstream server from the config
  if command -v jq >/dev/null; then
    # the proxy outbound is not always the one that dials out: in hand-written
    # chained profiles "proxy" may tunnel through another outbound that holds the
    # real server. Pick the first outbound that has a vnext.
    ob=$(jq -c 'first(.outbounds[] | select(.settings.vnext[0].address))' "$target")
    addr=$(echo "$ob" | jq -r '.settings.vnext[0].address')
    port=$(echo "$ob" | jq -r '.settings.vnext[0].port')
    sni=$(echo  "$ob" | jq -r '.streamSettings.realitySettings.serverName // .streamSettings.tlsSettings.serverName // ""')
    info "server: $addr:$port  (sni: $sni)"
    SERVER_ADDR=$addr
    SERVER_PORT=$port
    SERVER_SNI=$sni
  fi
else
  bad "no active profile (symlink missing)"
fi

info "available profiles: $(ls "$PROFILES_DIR"/*.json 2>/dev/null | xargs -n1 basename | sed 's/\.json$//' | tr '\n' ' ')"

# ── 2. systemd ────────────────────────────────────────────────────────
hdr "xray service"
if systemctl is-active --quiet xray; then
  ok "active ($(systemctl show xray -p ActiveEnterTimestamp --value | cut -d' ' -f2-3))"
  mem=$(systemctl show xray -p MemoryCurrent --value)
  if [ -n "$mem" ] && [ "$mem" != "[not set]" ]; then
    info "memory: $(numfmt --to=iec "$mem" 2>/dev/null || echo "$mem bytes")"
  fi
  pid=$(systemctl show xray -p MainPID --value)
  info "pid: $pid"
else
  bad "inactive"
fi

# recent errors
errs=$(journalctl -u xray -n 50 --no-pager 2>/dev/null | grep -iE 'error|failed|warn' | grep -v "Special user nobody" | tail -3)
if [ -n "$errs" ]; then
  warn "recent warnings/errors:"
  echo "$errs" | sed 's/^/      /'
fi

# ── 3. Ports ──────────────────────────────────────────────────────────
hdr "listening ports"
for port in $SOCKS_PORT $HTTP_PORT; do
  if ss -tlnH "sport = :$port" | grep -q LISTEN; then
    ok "127.0.0.1:$port"
  else
    bad "127.0.0.1:$port — not listening"
  fi
done

# ── 4. Path to the server ────────────────────────────────────────────────
hdr "upstream server"
if [ -n "$SERVER_ADDR" ]; then
  t0=$(date +%s.%N)
  if timeout 5 bash -c "</dev/tcp/$SERVER_ADDR/$SERVER_PORT" 2>/dev/null; then
    t1=$(date +%s.%N)
    dur=$(awk "BEGIN {printf \"%.0f\", ($t1-$t0)*1000}")
    ok "tcp $SERVER_ADDR:$SERVER_PORT reachable (${dur}ms)"

    # DPI often drops the TLS ClientHello for some (ip, sni) pairs while leaving
    # TCP alone: the handshake never completes and the tunnel looks "down" for
    # no visible reason. Separating the two says whether to change the SNI on
    # both ends or to move the server altogether.
    tls_probe() {  # ip port sni -> 0 if the handshake completes
      timeout 10 curl -sS -k --noproxy '*' --max-time 8 -o /dev/null \
        --resolve "$3:$2:$1" "https://$3/" >/dev/null 2>&1
    }
    if [ -n "$SERVER_SNI" ]; then
      if tls_probe "$SERVER_ADDR" "$SERVER_PORT" "$SERVER_SNI"; then
        ok "tls handshake with sni $SERVER_SNI"
      else
        bad "tls with sni $SERVER_SNI never completes (tcp is up)"
        probe_sni="${XRS_SNI_PROBE:-www.zalando.de}"
        if tls_probe "$SERVER_ADDR" "$SERVER_PORT" "$probe_sni"; then
          warn "same ip answers with sni $probe_sni → the SNI is filtered, not the ip"
          warn "fix: change serverNames/dest on the server, then serverName here"
        else
          warn "no sni completes a handshake → the ip itself is blocked"
        fi
      fi
    fi
  else
    bad "tcp $SERVER_ADDR:$SERVER_PORT unreachable"
  fi
else
  warn "server address unknown (install jq for parsing)"
fi

# ── 5. Proxies work ───────────────────────────────────────────────
hdr "proxy tunnel"
proxy_ip=$(curl -s --max-time 8 -x socks5h://127.0.0.1:$SOCKS_PORT https://api.ipify.org 2>/dev/null)
if [ -n "$proxy_ip" ]; then
  ok "socks5 → $proxy_ip"
  # geoip lookup
  geo=$(curl -s --max-time 5 "https://ipapi.co/$proxy_ip/country_name/" 2>/dev/null)
  [ -n "$geo" ] && info "country: $geo"
else
  bad "socks5 tunnel not responding"
fi

http_ip=$(curl -s --max-time 8 -x http://127.0.0.1:$HTTP_PORT https://api.ipify.org 2>/dev/null)
if [ -n "$http_ip" ]; then
  ok "http → $http_ip"
else
  bad "http proxy not responding"
fi

# ── 5b. Tunnel stability ─────────────────────────────────────────────
# A long-running xray accumulates dead/black-holed upstream sockets that get
# reused and hang until timeout — a fresh process is always healthy. This probe
# hits a fixed IP (DNS excluded) several times: intermittent stalls here mean
# the process has degraded and just needs a restart, not a different server.
hdr "tunnel stability"
total=6; stall=0
for _ in $(seq 1 $total); do
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 6 \
    -x socks5h://127.0.0.1:$SOCKS_PORT \
    --resolve api.ipify.org:443:104.26.12.205 https://api.ipify.org 2>/dev/null)
  [ "$code" = "200" ] || stall=$((stall + 1))
done
if [ "$stall" -eq 0 ]; then
  ok "$total/$total requests ok — tunnel healthy"
elif [ "$stall" -lt "$total" ]; then
  bad "$stall/$total requests stalled — process degraded; restart: sudo systemctl restart xray"
else
  bad "$total/$total requests stalled — tunnel down (switch profile or restart xray)"
fi

# piled-up half-closed sockets = accumulating dead upstream flows
if [ -n "$SERVER_ADDR" ]; then
  fw=$(ss -tnH state fin-wait-1 dst "$SERVER_ADDR" 2>/dev/null | wc -l)
  scope="to server"
else
  fw=$(ss -tnH state fin-wait-1 2>/dev/null | wc -l)
  scope="system-wide"
fi
if [ "$fw" -gt 20 ]; then
  warn "$fw sockets in FIN-WAIT-1 ($scope) — dead flows piling up, restart recommended"
else
  info "FIN-WAIT-1 sockets ($scope): $fw"
fi

# ── 6. Split tunneling ───────────────────────────────────────────────
hdr "routing split"
direct_ip=$(curl -s --noproxy '*' --max-time 8 https://api.ipify.org 2>/dev/null)
[ -n "$direct_ip" ] && info "your real ip: $direct_ip"

# proxy exit country
proxy_country=$(curl -s --max-time 8 -x socks5h://127.0.0.1:$SOCKS_PORT \
  "https://ipwho.is/?output=json" 2>/dev/null | grep -oP '"country":"[^"]*"' | head -1 | cut -d'"' -f4)
info "proxy exit country: ${proxy_country:-unknown}"

# .ru must go direct: yandex has to see our real IP
ya_ip=$(curl -s --max-time 8 -x socks5h://127.0.0.1:$SOCKS_PORT \
  "https://yandex.ru/internet/api/v0/ip/" 2>/dev/null | grep -oP '\d+\.\d+\.\d+\.\d+' | head -1)
if [ -n "$ya_ip" ]; then
  if [ "$ya_ip" = "$direct_ip" ]; then
    ok "yandex sees real ip $ya_ip  — .ru routed direct ✓"
  else
    bad "yandex sees $ya_ip (not $direct_ip) — .ru may be going through proxy"
  fi
else
  warn "yandex ip-check unreachable"
fi

# ── 7. Geo files ─────────────────────────────────────────────────────
hdr "geo files"
for f in geoip.dat geosite.dat; do
  path="/usr/local/share/xray/$f"
  if [ -f "$path" ]; then
    size=$(du -h "$path" | cut -f1)
    age=$(( ($(date +%s) - $(stat -c %Y "$path")) / 3600 ))
    ok "$f  ${D}($size, ${age}h old)${N}"
  else
    bad "$f missing"
  fi
done

# ── 8. DNS ────────────────────────────────────────────────────────────
hdr "dns"
if [ -f /etc/resolv.conf ]; then
  ns=$(grep '^nameserver' /etc/resolv.conf | awk '{print $2}' | tr '\n' ' ')
  info "system: $ns"
fi

echo
