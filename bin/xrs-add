#!/usr/bin/env bash
set -euo pipefail

PROFILES_DIR="/etc/xray/profiles"
XRS_LIB="${XRS_LIB:-/usr/local/lib/xrs}"

# locate shared library (installed path, or repo-relative when run in place)
if [[ -f "$XRS_LIB/build.sh" ]]; then
  # shellcheck source=../lib/xrs/build.sh
  source "$XRS_LIB/build.sh"
elif [[ -f "$(dirname "$0")/../lib/xrs/build.sh" ]]; then
  source "$(dirname "$0")/../lib/xrs/build.sh"
else
  echo "✗ xrs library not found (expected $XRS_LIB/build.sh)" >&2
  exit 1
fi

R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; D=$'\e[2m'; N=$'\e[0m'
die() { echo "${R}✗${N} $*" >&2; exit 1; }
ok()  { echo "${G}✓${N} $*"; }

usage() {
  cat <<EOF
Usage: xrs-add <vless://...> [profile-name]

  Parses a VLESS URI, validates it, and saves as an xray profile.
  Profile name is taken from the URI fragment (#name) or second argument.

Examples:
  xrs-add 'vless://uuid@host:443?security=reality&...' finland
  xrs-add 'vless://uuid@host:443?...#finland'
EOF
  exit 1
}

# ── Read URI ─────────────────────────────────────────────────────────────

if [[ $# -lt 1 ]]; then
  echo -n "Paste VLESS key: "
  read -r uri
else
  uri="$1"
fi

[[ -z "$uri" ]] && usage

# ── Parse & validate ───────────────────────────────────────────────────────

xrs_parse_uri "$uri" || die "could not parse URI"

# profile name: CLI arg > fragment > prompt
name="${2:-$VL_name}"
if [[ -z "$name" ]]; then
  read -rp "Profile name: " name
fi
[[ -z "$name" ]] && die "profile name is required"
name=$(xrs_sanitize_name "$name")

if ! xrs_validate; then
  echo "${R}Validation failed.${N}" >&2
  exit 1
fi

[[ -f "$PROFILES_DIR/$name.json" ]] && die "profile '$name' already exists"

# ── Build ──────────────────────────────────────────────────────────────────

config=$(xrs_build_config) || die "failed to build config"

# ── Preview ──────────────────────────────────────────────────────────────

echo
echo "${Y}Profile: ${N}$name"
echo "${D}server:  ${N}$VL_address:$VL_port"
echo "${D}uuid:    ${N}${VL_uuid:0:8}...${VL_uuid: -4}"
echo "${D}security:${N} $VL_security"
[[ -n "$VL_sni" ]]  && echo "${D}sni:     ${N}$VL_sni"
[[ -n "$VL_flow" ]] && echo "${D}flow:    ${N}$VL_flow"
echo

# ── Save ─────────────────────────────────────────────────────────────────

dest="$PROFILES_DIR/$name.json"
echo "$config" | sudo tee "$dest" > /dev/null
sudo chgrp nogroup "$dest"
sudo chmod 640 "$dest"

ok "saved $dest"
echo "${D}switch with:${N} xrs"
